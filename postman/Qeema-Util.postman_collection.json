              "raw": "{\r\n  \"name\": \"{{templateName}}\",\r\n  \"subjectTemplate\": \"Welcome back, {{name}}!\",\r\n  \"htmlContent\": \"<html><body><h1>Welcome back, {{name}}!</h1></body></html>\",\r\n  \"enabled\": true\r\n}"
