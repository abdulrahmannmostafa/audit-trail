    {
      "name": "03 - Email",
      "item": [
        {
          "name": "Send plain-text email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"to\": [\"recipient@example.com\"],\r\n  \"cc\": [],\r\n  \"bcc\": [],\r\n  \"subject\": \"Qeema test email\",\r\n  \"body\": \"This is a plain-text email sent from Qeema.\",\r\n  \"templateName\": null,\r\n  \"variables\": {}\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/emails/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "emails",
                "send"
              ]
            }
          }
        },
        {
          "name": "Send template email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"to\": [\"recipient@example.com\"],\r\n  \"cc\": [],\r\n  \"bcc\": [],\r\n  \"subject\": null,\r\n  \"body\": null,\r\n  \"templateName\": \"{{templateName}}\",\r\n  \"variables\": {\r\n    \"name\": \"Abdelrahman\",\r\n    \"email\": \"recipient@example.com\",\r\n    \"dashboardUrl\": \"https://example.com/dashboard\",\r\n    \"supportEmail\": \"support@example.com\"\r\n  }\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/emails/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "emails",
                "send"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Email templates",
      "item": [
        {
          "name": "Create welcome template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('templateName', pm.response.json().name);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"welcome-email\",\r\n  \"subjectTemplate\": \"Welcome to Qeema, {{name}}!\",\r\n  \"htmlContent\": \"<html><body><h1>Welcome, {{name}}!</h1><p>Your email is {{email}}.</p><p><a href=\\\"{{dashboardUrl}}\\\">Open dashboard</a></p></body></html>\",\r\n  \"enabled\": true\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/email-templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "email-templates"
              ]
            }
          }
        },
